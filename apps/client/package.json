{
  "name": "@ets2/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "os": [
    "win32"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build:exe": "bun build --compile --target=bun-windows-x64 src/index.ts --windows-icon=icon.ico --outfile dist/ets2-tracker.exe",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ets2/shared": "workspace:*",
    "koffi": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.6.3"
  }
}
