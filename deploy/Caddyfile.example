# Place this at /etc/caddy/Caddyfile on the box. Reload after edits with:
#   sudo systemctl reload caddy
#
# Caddy issues + auto-renews Let's Encrypt certs for every domain listed below.
# Make sure each domain's A record points at this box before adding it here —
# Let's Encrypt's HTTP-01 challenge will fail otherwise and you'll be rate
# limited for ~an hour.

# Global options
{
    email kyle.scudder@crimsontide.co.uk     # used for ACME registration + expiry notifications
}

# ---------------------------------------------------------------------------
# Per-project stanzas. Each project gets two domains:
#
#   api.<project>.<your-domain>     → Kong (API surface)
#   studio.<project>.<your-domain>  → Kong (also serves Studio at /)
#
# The api.* stanza also exposes a `/auth-templates/*` path that serves the
# email-template HTML files for GoTrue. Templates are not sensitive (just
# HTML with Go template placeholders), but it's a public URL — keep that
# in mind if you edit the files.
#
# Add a pair per project; reload Caddy after every edit.
# ---------------------------------------------------------------------------

# ETS2 friends tracker
api.ets2.kylescudder.co.uk {
    handle /auth-templates/* {
        root * /opt/supabase/ets2/volumes/auth/templates
        file_server
        uri strip_prefix /auth-templates
    }
    reverse_proxy 127.0.0.1:8001
    encode zstd gzip
}

studio.ets2.kylescudder.co.uk {
    # Studio is gated by basic auth (DASHBOARD_USERNAME / DASHBOARD_PASSWORD
    # from .env) but defence-in-depth is cheap. Uncomment to lock down by IP:
    # @notme not remote_ip 1.2.3.4/32
    # respond @notme 403

    reverse_proxy 127.0.0.1:8001
    encode zstd gzip
}

# Deadwax Club iOS app
api.deadwaxclub.app {
    handle /auth-templates/* {
        root * /opt/supabase/deadwax/volumes/auth/templates
        file_server
        uri strip_prefix /auth-templates
    }
    reverse_proxy 127.0.0.1:8011
    encode zstd gzip
}

studio.deadwax.kylescudder.co.uk {
    reverse_proxy 127.0.0.1:8011
    encode zstd gzip
}

