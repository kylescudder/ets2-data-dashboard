{
  "name": "ets2-data-dashboard",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:api": "pnpm --filter @ets2/api dev",
    "dev:web": "pnpm --filter @ets2/web dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @ets2/api migrate",
    "db:seed": "pnpm --filter @ets2/api seed",
    "simulate": "pnpm --filter @ets2/api simulate"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
