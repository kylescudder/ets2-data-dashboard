{
  "name": "cabmate",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @ets2/web dev",
    "dev:web": "bun run --filter @ets2/web dev",
    "dev:client": "bun run --filter @ets2/client dev",
    "build": "bun run --filter @ets2/web build",
    "start": "bun run --filter @ets2/web start",
    "typecheck": "bun run --filter \"*\" typecheck",
    "test": "bun test apps/web/server",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @ets2/web db:generate",
    "db:migrate": "bun run --filter @ets2/web db:migrate",
    "db:import": "bun run --filter @ets2/web db:import",
    "simulate": "bun run scripts/simulate.ts",
    "test:e2e": "playwright test",
    "test:clerk": "playwright test --config playwright.clerk.config.ts",
    "radio:install": "cd services/radio-max && bun install --frozen-lockfile",
    "radio:dev": "cd services/radio-max && bun run dev",
    "radio:build": "cd services/radio-max && bun run build",
    "radio:test": "cd services/radio-max && bun run test",
    "radio:typecheck": "cd services/radio-max && bun run typecheck"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.53",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.3.11",
    "typescript": "^7.0.0"
  }
}
