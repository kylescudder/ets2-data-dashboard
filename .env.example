DATABASE_URL=postgres://ets2:ets2@localhost:5432/ets2
API_PORT=4000

# Shared password for the dashboard. Both API and web read this; same value on both sides.
DASHBOARD_PASSWORD=letmein

# HMAC key for signing session cookies. Used independently by API (its own cookie)
# and web (its own cookie); they don't need to match, but using the same value is fine.
SESSION_SECRET=dev-session-secret-change-me

# Server-to-server bearer token. Web's server components send this to the API so SSR
# fetches bypass the cookie auth. Must be the same on both sides.
INTERNAL_API_TOKEN=dev-internal-token-change-me

# Browser-facing origin of the web app. The API echoes this in CORS allow-origin.
WEB_ORIGIN=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Supabase (web). Local CLI emits these on `supabase status`; in cloud, copy
# from the Supabase dashboard. The publishable key is safe in the browser; the
# service role / secret key is server-only and never exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
